{
  "manifest_version": 3,
  "name": "MeetDolff",
  "version": "0.2.0",
  "description": "AI meeting companion — record, transcribe, remember. Local-first memory with provider-independent AI.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "sidePanel", "activeTab"],
  "optional_permissions": ["desktopCapture"],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.tavily.com/*",
    "https://api.search.brave.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MeetDolff",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "settings.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
