{
  "name": "meetdolff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MeetDolff — AI meeting companion Chrome extension. Local-first memory, provider-independent AI, portable meeting memory files.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
